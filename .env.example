DATABASE_URL="mysql://user:password@host:3306/database"

NEXT_PUBLIC_API_DEFAULT_URL='localhost:3000'

NEXT_APPNAME=lottery
NEXT_TITLE=Lotofacil Business Intelligence

# E-mail que recebe aprovação automática e privilégios de administrador
ADMIN_EMAIL=email@gmail.com

# Autenticação (Google OAuth via Auth.js / NextAuth v5)
# Recomendado: colocar estas 3 em .env.local (não versionado), não aqui.
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET: criar em https://console.cloud.google.com/apis/credentials
# AUTH_SECRET: gerar com `npx auth secret`
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
